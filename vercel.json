{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs", "installCommand": "npm install --include=dev --workspaces --include-workspace-root" },
    "admin": { "root": "apps/admin", "framework": "nextjs", "installCommand": "npm install --include=dev --workspaces --include-workspace-root" }
  },
  "rewrites": [
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
