{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs", "installCommand": "npm install --include=dev --workspaces --include-workspace-root" },
    "admin": { "root": "apps/admin", "framework": "nextjs", "installCommand": "npm install --include=dev --workspaces --include-workspace-root" },
    "backend": { "root": "backend", "framework": "express", "entrypoint": "src/serverless.ts", "installCommand": "npm install --include=dev --workspaces --include-workspace-root" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "schedules": {
    "shift-recovery": { "schedule": "*/15 * * * *", "path": "/api/v1/scheduled/shift-recovery" },
    "match-retention": { "schedule": "0 3 * * *", "path": "/api/v1/scheduled/match-retention" }
  }
}
