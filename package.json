{
  "name": "bsm-healthforce",
  "private": true,
  "workspaces": ["packages/*", "backend", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev -w @bsm/web",
    "dev:web": "npm run dev -w @bsm/web",
    "dev:admin": "npm run dev -w @bsm/admin",
    "dev:backend": "npm run dev -w @bsm/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^3.2.4", "tsx": "^4.20.0", "@types/node": "^24.0.0" },
  "overrides": { "postcss": "^8.5.33" }
}
