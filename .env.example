# Backend (backend/). Copy to backend/.env for local development. Never commit real values.

NODE_ENV=development                 # development | test | production
PORT=4000                            # API port
WEB_URL=http://localhost:3000        # Allowed browser origin + links in emails
ADMIN_URL=http://localhost:3001      # Allowed browser origin for the admin app
DATABASE_URL=                        # Postgres URL. Empty in development = embedded PGlite in backend/.data (REQUIRED in production)
MFA_ENCRYPTION_KEY=                  # REQUIRED. 32 random bytes, base64. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=                # REQUIRED. 32 random bytes, base64 (different from MFA key). Encrypts credential numbers; signs file-download links
FILE_STORAGE_DIR=./.data/files       # Local dev private document storage. Keep outside any web-served directory. Refused in production (see STORAGE_* below)
LOG_LEVEL=info                       # optional
BSM_ADMIN_PASSWORD=                  # only for `npm run create-admin`; 12+ chars; unset afterwards
NEW_MFA_ENCRYPTION_KEY=              # only for `npm run rotate-keys` (re-encrypts MFA secrets under this key); unset afterwards
NEW_FIELD_ENCRYPTION_KEY=            # only for `npm run rotate-keys` (re-encrypts credential numbers); unset afterwards

# Email (REQUIRED in production; the API refuses to start without it). Development default: EMAIL_PROVIDER=console prints links to the terminal.
EMAIL_PROVIDER=                      # resend | postmark | console (console is refused in production)
EMAIL_FROM=                          # e.g. "BSM HealthForce <no-reply@yourdomain.com>"; the domain must have SPF, DKIM and DMARC set up at the provider
RESEND_API_KEY=                      # when EMAIL_PROVIDER=resend
POSTMARK_SERVER_TOKEN=               # when EMAIL_PROVIDER=postmark
EMAIL_STREAM=outbound                # Postmark message stream (optional)

# Private document storage (REQUIRED in production). Any S3-compatible private bucket: AWS S3, Cloudflare R2, Backblaze B2, Supabase Storage, MinIO.
STORAGE_BUCKET=                      # bucket name; must block all public access and encrypt at rest; enable versioning
STORAGE_REGION=us-east-1             # AWS region, or "auto" for R2
STORAGE_ENDPOINT=                    # leave empty for AWS S3; e.g. https://<account>.r2.cloudflarestorage.com for R2, https://<ref>.supabase.co/storage/v1/s3 for Supabase
STORAGE_ACCESS_KEY_ID=               # a key scoped to this bucket only (unset = AWS default credential chain)
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false       # true for MinIO and some S3-compatible services
STORAGE_PREFIX=credential-documents/ # optional key prefix inside the bucket
STORAGE_SSE=                         # optional per-object encryption header: AES256 | aws:kms (prefer bucket default encryption instead)
STORAGE_KMS_KEY_ID=                  # with STORAGE_SSE=aws:kms

# Shared rate-limit counters (REQUIRED in production unless RATE_LIMIT_STORE=memory). Serverless instances do not share memory, so
# login, signup and search limits only hold across instances with a shared store. Upstash Redis via its REST API; no persistent connection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_STORE=                    # "memory" allows the per-process limiter in production: only correct for ONE long-running server, never on Vercel

# Malware scanning of uploaded documents (optional; strongly recommended before real users). Without it files are stored as not_scanned and labeled so.
CLAMAV_HOST=                         # a clamd reachable privately from the API (container on the same network, or a hosted clamd)
CLAMAV_PORT=3310

# AI assistant (optional). Without a key the assistant reports itself as not switched on; nothing is simulated.
ANTHROPIC_API_KEY=                   # optional. From console.anthropic.com. Backend only: never expose to the browser
ASSISTANT_MODEL=claude-opus-5-5      # optional. Defaults to claude-opus-5-5
ASSISTANT_EFFORT=medium              # optional: low | medium | high. Lower is faster and cheaper

# Unfilled shift recovery (optional). How often the API checks for shifts that need more outreach. 0 turns it off (timer and scheduled route).
SHIFT_RECOVERY_INTERVAL_MINUTES=5
MATCH_RETENTION_INTERVAL_HOURS=24    # match-run retention cleanup; 0 turns it off (timer and scheduled route)
CRON_SECRET=                         # External scheduler only (unset on the Droplet, whose server runs the timers): random string, 16+ chars. Vercel Schedules send it to /api/v1/scheduled/*; unset = those routes refuse

# Web and admin apps (apps/web, apps/admin). Public values only: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1   # where the browser reaches the API; the apps' origins must match WEB_URL / ADMIN_URL above
# Production: the apps are on Vercel and the API on a DigitalOcean Droplet, so set NEXT_PUBLIC_API_URL=https://api.<domain>/api/v1 on Vercel;
# the admin app's base path defaults to /admin there (NEXT_PUBLIC_BASE_PATH overrides). See infrastructure/deployment/README.md and deployment/droplet/

# Subscription billing (optional, off by default). Backend only: never expose these to the browser. See documentation/operations/subscription-billing-deployment.md
BILLING_SUBSCRIPTIONS_ENABLED=false  # true turns on checkout and lets staff gate organizations one by one
BILLING_GRACE_DAYS=7                 # days a past-due subscription keeps paid features
STRIPE_SECRET_KEY=                   # sk_test_... or a restricted key. Unset = checkout and webhooks report unavailable
STRIPE_WEBHOOK_SECRET=               # whsec_... signing secret of the webhook endpoint
