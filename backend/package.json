{
  "name": "@bsm/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@bsm/permissions": "*",
    "@electric-sql/pglite": "^0.3.0",
    "@node-rs/argon2": "^2.0.2",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
