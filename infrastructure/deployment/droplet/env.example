# Copy to .env in this folder on the Droplet (chmod 600 .env). Values are read by compose.yml and passed to the API container.
# Full descriptions of every backend variable: .env.example at the repository root.

# --- server ---
API_DOMAIN=api.example.com                      # DNS A record must point at the Droplet before the first start
WEB_URL=https://app.example.com                 # the Vercel deployment; feeds CORS, the Origin check and email links
ADMIN_URL=https://app.example.com/admin

# --- database ---
# Neon (default): the POOLED connection string (host contains "-pooler") with sslmode=require. Neon's certificate is publicly
# trusted, so no CA file is needed; this pg version verifies the chain and host name for sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DigitalOcean Managed PostgreSQL instead: the connection-pool endpoint, with the cluster's CA saved as ./certs/db-ca.crt:
#DATABASE_URL=postgresql://USER:PASSWORD@HOST:25061/DB?sslmode=verify-full&sslrootcert=/run/ca/db-ca.crt

# --- secrets (openssl rand -base64 32, two different values; back them up separately from the database) ---
MFA_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

# --- email (one provider) ---
EMAIL_PROVIDER=resend
EMAIL_FROM="BSM HealthForce <no-reply@example.com>"
RESEND_API_KEY=
#POSTMARK_SERVER_TOKEN=

# --- documents (DigitalOcean Spaces; leave STORAGE_SSE unset, Spaces ignores the header) ---
STORAGE_BUCKET=
STORAGE_REGION=nyc3
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- virus scanning (off for now) ---
# To turn it on later: resize the Droplet to 4 GB RAM (clamd needs about 1.3 GB), uncomment both lines, run ./deploy.sh.
#COMPOSE_PROFILES=scanner
#CLAMAV_HOST=clamav

# --- schedulers (in-process timers; no CRON_SECRET is needed on a long-running server) ---
# Every pass wakes the database. On Neon's free plan a 5-minute timer keeps compute on around the clock and can use up the
# monthly compute allowance; 30 lets it sleep between passes. 0 turns recovery off.
SHIFT_RECOVERY_INTERVAL_MINUTES=30
MATCH_RETENTION_INTERVAL_HOURS=0                # keep 0 until a person has watched the first run (match-retention-deployment.md)

# --- optional ---
BILLING_SUBSCRIPTIONS_ENABLED=false
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#ANTHROPIC_API_KEY=
LOG_LEVEL=info
